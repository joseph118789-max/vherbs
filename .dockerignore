# VHerbs — files excluded from the Docker build context

# Local development + verification
_screenshots/
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Docker self-reference
Dockerfile
.dockerignore

# Any future build output (e.g. if a bundler is added later)
node_modules/
dist/
build/

# Local env / secrets
.env
.env.*
*.local